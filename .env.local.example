# Tells the Inngest SDK it's running against the local Dev Server, not production.
INNGEST_DEV=1

# OpenRouter (OpenAI-compatible) settings for the LLM decision calls.
# Copy this file to .env.local and fill in your real key.
# Get a key at https://openrouter.ai/keys — see README for the full setup steps.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
# openrouter/free routes every request to a random free model, which can give
# inconsistent answers on the same input. Pin one specific free model instead
# for repeatable decisions — see README for how to pick/verify one.
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free
